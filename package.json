{
  "name": "prototech-intelli",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prepare-db.js && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "node scripts/prepare-db.js && prisma generate",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:switch:postgres": "node scripts/switch-db.js postgres",
    "db:switch:sqlite": "node scripts/switch-db.js sqlite",
    "test": "npx tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.21.1",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "libphonenumber-js": "^1.11.12",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.21.1",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
